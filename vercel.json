{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/app/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/install", "destination": "https://github.com/brucestarlove/ss-nebula#install", "permanent": false },
    { "source": "/support", "destination": "https://github.com/brucestarlove/ss-nebula/issues", "permanent": false }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/ss-nebula-32x32.png" },
    { "source": "/b/:path*", "destination": "/index.html" },
    { "source": "/p/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-aU8bDOXlRk2raF4+vHOhwa0O9/p8ye/nMr4uLOdemwg=' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; frame-src blob:; worker-src 'self' blob:; connect-src 'self' https://libraries.excalidraw.com https://raw.githubusercontent.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
