{
  "name": "@starlove/nebula",
  "version": "2.0.4",
  "description": "Starscape Nebula: notes, Excalidraw drawings and media as real files in projects, in your browser or served from your own folders (nebula run).",
  "license": "AGPL-3.0",
  "type": "module",
  "bin": {
    "nebula": "./bin/nebula.mjs"
  },
  "packageManager": "pnpm@10.22.0",
  "exports": {
    "./app": "./cli/app.mjs",
    "./files": "./cli/nebula-files.mjs",
    "./backend": "./cli/backend.mjs",
    "./backends/database": "./cli/backends/database.mjs",
    "./bytes/store": "./cli/bytes/store.mjs",
    "./bytes/folder": "./cli/bytes/folder.mjs",
    "./conformance/bytes": "./cli/conformance/bytes.mjs",
    "./conformance/backend": "./cli/conformance/backend.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "cli",
    "dist/app",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css",
    "src/nebula/style.ts",
    "src/workspace/style.ts"
  ],
  "homepage": "https://nebula.starscape.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brucestarlove/ss-nebula.git"
  },
  "bugs": {
    "url": "https://github.com/brucestarlove/ss-nebula/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "excalidraw",
    "whiteboard",
    "canvas",
    "notes",
    "markdown",
    "obsidian",
    "opfs",
    "starscape",
    "orbit",
    "local-first"
  ],
  "scripts": {
    "prepack": "pnpm run build:package",
    "prepublishOnly": "pnpm run verify",
    "dev": "vite",
    "dev:site": "pnpm run build:site && node serve-site.mjs",
    "build": "pnpm run build:app",
    "build:app": "tsc -b && vite build",
    "build:site": "pnpm run typecheck && node scripts/build-site.mjs",
    "build:landing": "vite build --config vite.site.config.ts",
    "build:cloudflare": "pnpm run build:site && node scripts/cloudflare-assets.mjs",
    "deploy": "pnpm run verify && pnpm run build:cloudflare && wrangler deploy",
    "deploy:preview": "pnpm run build:cloudflare && wrangler versions upload --preview-alias preview",
    "build:cli-app": "vite build --base=./ --outDir dist/app --emptyOutDir && node -e \"require('node:fs').copyFileSync('routes.json', 'dist/app/routes.json')\"",
    "build:package": "pnpm run build:cli-app",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --environment jsdom --pool=vmThreads",
    "test:watch": "vitest --environment jsdom --pool=vmThreads",
    "smoke": "vitest run --environment jsdom --pool=vmThreads src/nebula/runtimeSmoke.test.tsx",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run lint",
    "pack:dry-run": "npm pack --dry-run",
    "preview": "vite preview",
    "serve:site": "node serve-site.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^9.36.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "1.64.1",
    "@starlove/ui": "^3.3.3",
    "@starlove/ui-react": "^3.3.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "codemirror": "^6.0.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "fflate": "^0.8.3",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "lz-string": "^1.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.7",
    "wrangler": "4.151.3"
  }
}
